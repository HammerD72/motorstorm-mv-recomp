# Binding and source flags are scoped so unrelated generated TUs keep their commands.
set(MOTORSTORM_NATIVE_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(MOTORSTORM_NATIVE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
option(PORT_NATIVE_WORLD_TRANSFORMS "Bind verified native scene hierarchy work" OFF)
option(PORT_NATIVE_JOB_WAIT "Bind verified native cooperative job waits" OFF)
option(PORT_NATIVE_VISIBILITY "Bind verified native box/plane visibility work" OFF)
option(PORT_NATIVE_PARTICLE_THRESHOLDS "Bind verified native particle threshold scans" OFF)
set(PORT_TARGET_ELF "" CACHE FILEPATH "Original ELF for verified native game binding")

function(motorstorm_bind_world_transforms)
    if(NOT PORT_NATIVE_WORLD_TRANSFORMS AND NOT PORT_NATIVE_JOB_WAIT AND NOT PORT_NATIVE_VISIBILITY)
        return()
    endif()
    if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
        message(FATAL_ERROR "Native game bindings currently require an x86-64 build")
    endif()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    get_filename_component(input_root "${RECOMP_DIR}" DIRECTORY)
    set(manifest "${CMAKE_BINARY_DIR}/native-world-binding.json")
    set(binding_options)
    if(NOT PORT_NATIVE_WORLD_TRANSFORMS)
        list(APPEND binding_options --without-world-transforms)
    endif()
    if(PORT_NATIVE_JOB_WAIT)
        list(APPEND binding_options --job-wait)
    endif()
    if(PORT_NATIVE_VISIBILITY)
        list(APPEND binding_options --visibility)
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${MOTORSTORM_NATIVE_ROOT}/scripts/native_game_binding.py"
        --generated "${input_root}" --output "${CMAKE_BINARY_DIR}/native-world-input"
        --elf "${PORT_TARGET_ELF}" --manifest "${manifest}" ${binding_options}
        RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Native game binding failed:\n${report}\n${errors}")
    endif()
    file(READ "${manifest}" binding)
    string(JSON count LENGTH "${binding}" bindings)
    math(EXPR last "${count} - 1")
    foreach(number RANGE 0 ${last})
        string(JSON original GET "${binding}" bindings ${number} original_tu)
        string(JSON copied GET "${binding}" bindings ${number} copied_tu)
        string(JSON context GET "${binding}" bindings ${number} context)
        if(context STREQUAL "spu_context")
            set(source_list SPU_SOURCES)
        else()
            set(source_list RECOMP_SOURCES)
        endif()
        list(FIND ${source_list} "${original}" index)
        if(index EQUAL -1)
            message(FATAL_ERROR "Verified reference TU is missing from ${source_list}")
        endif()
        list(REMOVE_ITEM ${source_list} "${original}")
        list(APPEND ${source_list} "${copied}")
        if(context STREQUAL "spu_context")
            foreach(property COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
                get_source_file_property(value "${original}" ${property})
                if(NOT value STREQUAL "NOTFOUND")
                    set_source_files_properties("${copied}" PROPERTIES ${property} "${value}")
                endif()
            endforeach()
        endif()
    endforeach()
    set(RECOMP_SOURCES "${RECOMP_SOURCES}" PARENT_SCOPE)
    set(SPU_SOURCES "${SPU_SOURCES}" PARENT_SCOPE)
    message(STATUS "${report}")
endfunction()

function(motorstorm_configure_world_transforms target)
    if(NOT PORT_NATIVE_WORLD_TRANSFORMS AND NOT PORT_NATIVE_JOB_WAIT AND NOT PORT_NATIVE_VISIBILITY AND NOT PORT_NATIVE_PARTICLE_THRESHOLDS)
        return()
    endif()
    set(adapter "${MOTORSTORM_NATIVE_SOURCE_DIR}/scene_hierarchy.cpp")
    set(cpu "${MOTORSTORM_NATIVE_SOURCE_DIR}/native_cpu.cpp")
    set(core "${MOTORSTORM_NATIVE_SOURCE_DIR}/world_transforms.cpp")
    set(baseline_sources)
    set(math_sources)
    if(PORT_NATIVE_WORLD_TRANSFORMS)
        list(APPEND baseline_sources "${adapter}" "${cpu}")
        list(APPEND math_sources "${core}")
    endif()
    if(PORT_NATIVE_JOB_WAIT)
        list(APPEND baseline_sources "${MOTORSTORM_NATIVE_SOURCE_DIR}/job_wait.cpp" "${MOTORSTORM_NATIVE_SOURCE_DIR}/job_wait_adapter.cpp")
    endif()
    if(PORT_NATIVE_VISIBILITY)
        set(visibility_adapter "${MOTORSTORM_NATIVE_SOURCE_DIR}/visibility_adapter.cpp")
        list(APPEND baseline_sources "${visibility_adapter}" "${cpu}")
        list(APPEND math_sources "${MOTORSTORM_NATIVE_SOURCE_DIR}/visibility_planes.cpp")
        set_source_files_properties("${visibility_adapter}" PROPERTIES INCLUDE_DIRECTORIES "${PS3RECOMP_DIR}/runtime/spu")
    endif()
    if(PORT_NATIVE_PARTICLE_THRESHOLDS)
        find_package(Python3 REQUIRED COMPONENTS Interpreter)
        set(particle_input "${CMAKE_BINARY_DIR}/native-particle-input")
        execute_process(COMMAND "${Python3_EXECUTABLE}" "${MOTORSTORM_NATIVE_ROOT}/scripts/native_particle_binding.py"
            --elf "${PORT_TARGET_ELF}" --output "${particle_input}"
            RESULT_VARIABLE particle_status OUTPUT_VARIABLE particle_report ERROR_VARIABLE particle_errors)
        if(NOT particle_status EQUAL 0)
            message(FATAL_ERROR "Particle code binding failed:\n${particle_report}\n${particle_errors}")
        endif()
        set(particle_sources "${MOTORSTORM_NATIVE_SOURCE_DIR}/threshold_adapter.cpp"
            "${MOTORSTORM_NATIVE_SOURCE_DIR}/threshold_scan.cpp" "${particle_input}/particle_code_identity.cpp")
        list(APPEND baseline_sources ${particle_sources})
        set_source_files_properties(${particle_sources} PROPERTIES INCLUDE_DIRECTORIES "${PS3RECOMP_DIR}/runtime/spu")
        message(STATUS "${particle_report}")
    endif()
    list(REMOVE_DUPLICATES baseline_sources)
    target_sources(${target} PRIVATE ${baseline_sources})
    if(math_sources)
        target_sources(${target} PRIVATE ${math_sources})
    endif()
    if(MSVC)
        set_source_files_properties(${baseline_sources} PROPERTIES COMPILE_OPTIONS "/O2;/Ob2;/EHsc")
        foreach(math_source IN LISTS math_sources)
            set_source_files_properties("${math_source}" PROPERTIES COMPILE_OPTIONS "/O2;/Ob2;/EHsc;/arch:AVX2;/fp:strict")
        endforeach()
    else()
        set_source_files_properties(${baseline_sources} PROPERTIES COMPILE_OPTIONS "-O2;-fexceptions")
        foreach(math_source IN LISTS math_sources)
            set_source_files_properties("${math_source}" PROPERTIES COMPILE_OPTIONS "-O2;-fexceptions;-mavx2;-mfma;-ffp-contract=off;-frounding-math")
        endforeach()
    endif()
    # This scan needs baseline x86-64 only. Its comparisons preserve caller FP
    # state and must retain strict semantics independently of other math units.
    if(PORT_NATIVE_PARTICLE_THRESHOLDS)
        if(MSVC)
            set_source_files_properties(${particle_sources} PROPERTIES COMPILE_OPTIONS "/O2;/Ob2;/EHsc;/fp:strict")
        else()
            set_source_files_properties(${particle_sources} PROPERTIES COMPILE_OPTIONS "-O2;-fexceptions;-ffp-contract=off;-frounding-math")
        endif()
    endif()
endfunction()
