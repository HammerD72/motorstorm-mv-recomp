# Consumer-side tuning of native rendering code; guest and runtime policy stay unchanged.
option(PORT_OPTIMIZE_RENDERER "Use checked O2 and automatic inlining for native video/FIFO code" OFF)

function(motorstorm_configure_renderer_optimization runtime_root)
    set(names cellGcmSys.c rsx_d3d12_backend.c rsx_dispatch.c
        rsx_vertex_fetch.c rsx_vertex_compact.c rsx_texture_layout.c
        rsx_vp_decompiler.c rsx_fp_decompiler.c)
    set(json_sources "")
    if(PORT_OPTIMIZE_RENDERER)
        if(NOT PORT_OPTIMIZE_NATIVE OR NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
            message(FATAL_ERROR "Renderer optimization requires checked native Debug optimization")
        endif()
        if(NOT TARGET ps3recomp_runtime)
            message(FATAL_ERROR "Renderer optimization requires the runtime source target")
        endif()
        if(MSVC)
            if(NOT CMAKE_C_COMPILER_ID STREQUAL "Clang")
                message(FATAL_ERROR "Checked renderer optimization requires clang-cl on Windows")
            endif()
            set(options /clang:-O2 /Ob2)
        else()
            set(options -O2)
        endif()
        get_target_property(runtime_sources ps3recomp_runtime SOURCES)
        foreach(name IN LISTS names)
            set(source "${runtime_root}/libs/video/${name}")
            if(NOT EXISTS "${source}" OR NOT source IN_LIST runtime_sources)
                message(FATAL_ERROR "Selected renderer source is missing from the runtime target: ${name}")
            endif()
            # Source properties belong to the directory that created the target.
            set_property(SOURCE "${source}" TARGET_DIRECTORY ps3recomp_runtime
                         APPEND PROPERTY COMPILE_OPTIONS ${options})
            if(json_sources)
                string(APPEND json_sources ",")
            endif()
            string(APPEND json_sources "\"${name}\"")
        endforeach()
        set(enabled true)
    else()
        set(enabled false)
    endif()
    file(WRITE "${CMAKE_BINARY_DIR}/renderer-optimization.json"
         "{\"enabled\":${enabled},\"sources\":[${json_sources}]}\n")
endfunction()
