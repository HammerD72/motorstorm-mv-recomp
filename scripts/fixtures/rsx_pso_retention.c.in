/* Authored COM adapters execute production ownership and draw functions. */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
typedef uint32_t u32;
typedef uint64_t u64;
typedef int HRESULT;
#define S_OK 0
#define MAX_DRAWS 2048
#define RSX_GPU_REFERENCES_MAX (MAX_DRAWS + 1)
#include "rsx_gpu_references.h"
typedef struct ID3D12PipelineState ID3D12PipelineState;
typedef struct { void (*AddRef)(ID3D12PipelineState*); void (*Release)(ID3D12PipelineState*); } PsoVtbl;
struct ID3D12PipelineState { PsoVtbl *lpVtbl; unsigned refs; };
typedef struct Fence Fence;
typedef struct { u64 (*GetCompletedValue)(Fence*); } FenceVtbl;
struct Fence { FenceVtbl *lpVtbl; u64 value; };
typedef struct Device Device;
typedef struct { HRESULT (*GetDeviceRemovedReason)(Device*); } DeviceVtbl;
struct Device { DeviceVtbl *lpVtbl; HRESULT status; };
typedef struct CommandList CommandList;
typedef struct { void (*DrawInstanced)(CommandList*, u32, u32, u32, u32); } CommandVtbl;
struct CommandList { CommandVtbl *lpVtbl; };
static struct { Device *device; Fence *fence; u64 fence_values[2]; u32 frame_index; CommandList *cmd_list; } s_d3d;
static rsx_gpu_references s_gpu_pso_refs;
static unsigned waits, draws, failures;
static ID3D12PipelineState *bound;
static int failure_mode;
static void check(int ok, const char *name) { if (!ok) { fprintf(stderr, "FAIL %s\n", name); ++failures; } }
static void wait_for_gpu(void) { ++waits; }
@FUNCTIONS@
static void add(ID3D12PipelineState *p) { ++p->refs; }
static void release(ID3D12PipelineState *p) { check(p->refs != 0, "balanced references"); --p->refs; }
static HRESULT removed(Device *p) { return p->status; }
static u64 completed(Fence *p) { return p->value; }
static void draw(CommandList *p, u32 count, u32 instances, u32 first, u32 instance) {
    (void)p; check(count == 3 && instances == 1 && first == draws && instance == 0, "draw arguments preserved");
    check(bound->refs >= 2, "draw owns a recorded PSO reference"); ++draws;
}
static void aborted(int number) {
    (void)number;
    if (failure_mode && s_gpu_pso_refs.count == 276 && bound->refs == 1) _Exit(77);
    _Exit(78);
}
int main(int argc, char **argv) {
    signal(SIGABRT, aborted);
    PsoVtbl pv = {add, release}; FenceVtbl fv = {completed}; DeviceVtbl dv = {removed}; CommandVtbl cv = {draw};
    Device device = {&dv, S_OK}; Fence fence = {&fv, 17}; CommandList list = {&cv};
    s_d3d.device = &device; s_d3d.fence = &fence; s_d3d.cmd_list = &list;
    s_d3d.frame_index = 1; s_d3d.fence_values[1] = 17;
    ID3D12PipelineState objects[276];
    for (u32 i = 0; i < 276; ++i) {
        objects[i].lpVtbl = &pv; objects[i].refs = 1; bound = &objects[i];
        gpu_pso_draw(bound, 3, i);
        if (i >= 256) release(&objects[i - 256]);
    }
    check(objects[0].refs == 1, "recorded PSO survives cache eviction");
    for (unsigned i = 20; i < 276; ++i) release(&objects[i]);
    if (argc > 1) {
        failure_mode = 1;
        if (!strcmp(argv[1], "device")) device.status = -1;
        else if (!strcmp(argv[1], "incomplete")) fence.value = 16;
        else if (!strcmp(argv[1], "removed-sentinel")) fence.value = UINT64_MAX;
        else return 2;
        gpu_pso_retire();
        fprintf(stderr, "FAIL failed retirement released recorded PSO\n"); return 1;
    }
    gpu_pso_retire();
    check(waits == 1 && s_gpu_pso_refs.count == 0, "one checked retirement");
    for (unsigned i = 0; i < 276; ++i) check(objects[i].refs == 0, "recorded ownership released only after retirement");
    printf("draws=%u failures=%u\n", draws, failures); return failures ? 1 : 0;
}
