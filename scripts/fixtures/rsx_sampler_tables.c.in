/* Executes the production guest sampler decoder and table owner
 * (rsx_d3d12_guest_sampler.h, rsx_d3d12_sampler_tables.inc) and the actual
 * vp_upload_retire against owner-tagged COM objects. Modes: no argument runs
 * every check; "--mutant" expects failures and reports which checks caught it. */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <d3d12.h>
typedef uint32_t u32;
typedef uint64_t u64;
typedef uint8_t u8;

typedef struct { u32 address, filter, control0, border_color; } rsx_texture_regs;
typedef struct { rsx_texture_regs textures[16]; } rsx_state;
#define VP_FPSNAP_MAX 512
typedef struct { u32 off; u32 size; u64 hash; } VPFP_snap;
static VPFP_snap s_fp_snap[VP_FPSNAP_MAX];
static struct {
    ID3D12Device* device; ID3D12GraphicsCommandList* cmd_list; ID3D12DescriptorHeap* srv_heap;
    ID3D12Fence* fence; u64 fence_values[2]; u32 frame_index; const rsx_state* current_rsx_state;
} s_d3d;
static unsigned waits;
static void wait_for_gpu(void) { ++waits; }
@VP_UPLOAD_RETIRE@
#include "rsx_d3d12_guest_sampler.h"
/* The fields of the production D3D12DrawRecord the sampler owner reads. */
typedef struct { struct { int set; } tex[16]; rsx_guest_sampler_regs sampler[16]; rsx_depth_sample_view depth_view[16]; u32 fp_snap; } D3D12DrawRecord;
#include "rsx_d3d12_sampler_tables.inc"

static unsigned failures, checks;
static void check(int ok, const char* name)
{
    ++checks;
    if (!ok) { printf("FAIL %s\n", name); ++failures; }
}

/* ---- COM objects ------------------------------------------------------- */
static unsigned heap_release(ID3D12DescriptorHeap* h) { check(h->refs > 0, "balanced heap release"); return --h->refs; }
static D3D12_CPU_DESCRIPTOR_HANDLE* heap_cpu(ID3D12DescriptorHeap* h, D3D12_CPU_DESCRIPTOR_HANDLE* out) { out->ptr = (SIZE_T)h->base; return out; }
static D3D12_GPU_DESCRIPTOR_HANDLE* heap_gpu(ID3D12DescriptorHeap* h, D3D12_GPU_DESCRIPTOR_HANDLE* out) { out->ptr = h->base; return out; }
static const ID3D12DescriptorHeapVtbl heap_vtbl = {heap_release, heap_cpu, heap_gpu};
#define MAX_HEAPS 16
static ID3D12DescriptorHeap heaps[MAX_HEAPS];
static unsigned heap_n;
static HRESULT dev_create_heap(ID3D12Device* d, const D3D12_DESCRIPTOR_HEAP_DESC* desc, const IID* iid, void** out)
{
    (void)iid;
    check(desc->Type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER && desc->NumDescriptors == 2048 &&
          desc->Flags == D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE, "legal shader-visible sampler heap");
    if (heap_n == MAX_HEAPS) return -1;
    ID3D12DescriptorHeap* h = &heaps[heap_n];
    h->lpVtbl = &heap_vtbl; h->refs = 1; h->owner = d; h->base = (UINT64)(heap_n + 1) << 32;
    ++heap_n; ++d->heaps; *out = h; return S_OK;
}
static HRESULT dev_removed(ID3D12Device* d) { return d->status; }
static UINT dev_inc(ID3D12Device* d, D3D12_DESCRIPTOR_HEAP_TYPE t) { (void)d; (void)t; return 32; }
static unsigned samplers_written;
static D3D12_SAMPLER_DESC last_written[16];
static void dev_sampler(ID3D12Device* d, const D3D12_SAMPLER_DESC* desc, D3D12_CPU_DESCRIPTOR_HANDLE cpu)
{
    (void)d;
    unsigned unit = (unsigned)((cpu.ptr & 0xFFFFFFFFu) / 32u) % 16u;
    for (unsigned i = 0; i < heap_n; ++i)
        if ((cpu.ptr >> 32) == (heaps[i].base >> 32))
            check(heaps[i].refs > 0 && heaps[i].owner == s_d3d.device, "descriptor written into a live current-device heap");
    last_written[unit] = *desc; ++samplers_written;
}
static const ID3D12DeviceVtbl dev_vtbl = {dev_create_heap, dev_removed, dev_inc, dev_sampler};
static ID3D12DescriptorHeap* set_heaps[2];
static UINT64 last_table;
static void list_heaps(ID3D12GraphicsCommandList* l, UINT n, ID3D12DescriptorHeap* const* h)
{
    (void)l; check(n == 2, "SRV and sampler heaps bound together");
    set_heaps[0] = h[0]; set_heaps[1] = h[1];
}
static void list_table(ID3D12GraphicsCommandList* l, UINT p, D3D12_GPU_DESCRIPTOR_HANDLE g)
{
    (void)l; check(p == 3, "sampler table on root parameter 3");
    check(set_heaps[1] && (g.ptr >> 32) == (set_heaps[1]->base >> 32), "table lies in the bound sampler heap");
    last_table = g.ptr;
}
static const ID3D12GraphicsCommandListVtbl list_vtbl = {list_heaps, list_table};
static UINT64 fence_done(ID3D12Fence* f) { return f->value; }
static const ID3D12FenceVtbl fence_vtbl = {fence_done};

static ID3D12Device devices[2];
static ID3D12GraphicsCommandList list;
static ID3D12Fence fence;
static rsx_state state;

static void set_regs(rsx_guest_sampler_regs* r, u32 address, u32 filter, u32 control0, u32 border)
{
    r->address = address; r->filter = filter; r->control0 = control0; r->border = border;
}
static void draw_init(D3D12DrawRecord* dr, unsigned seed)
{
    memset(dr, 0, sizeof(*dr));
    for (unsigned u = 0; u < 16; ++u) {
        dr->tex[u].set = 1;
        set_regs(&dr->sampler[u], 0x00010101u, 0x02060000u, 0x80000000u | (3072u << 7), seed);
    }
}
static void frame_complete(void) { fence.value = s_d3d.fence_values[s_d3d.frame_index] + 1; }

/* ---- decoder ------------------------------------------------------------ */
static void decoder_checks(void)
{
    D3D12_SAMPLER_DESC d;
    rsx_guest_sampler_regs r;
    /* MotorStorm's cloud layer: wrap, min linear/mip-nearest, mag linear,
     * LOD bias -0.398 (-102/256), 2x anisotropy with a point mip filter. */
    set_regs(&r, 0x00010101u, 0x02040000u | (8192u - 102u), 0x80000000u | (1u << 4) | (3072u << 7), 0);
    check(rsx_guest_sampler(&r, &d) == 1, "cloud state decodes");
    check(d.AddressU == D3D12_TEXTURE_ADDRESS_MODE_WRAP && d.AddressV == D3D12_TEXTURE_ADDRESS_MODE_WRAP,
          "cloud wrap addressing");
    check(d.Filter == D3D12_ENCODE_BASIC_FILTER(1, 1, 0, 0) && d.MaxAnisotropy == 1,
          "cloud linear/linear/mip-point stays 1x");
    check(d.MipLODBias < -0.39f && d.MipLODBias > -0.40f, "signed LOD bias");
    set_regs(&r, 0x00010101u, 0x02060000u, 0x80000000u | (4u << 4) | (3072u << 7), 0);
    check(rsx_guest_sampler(&r, &d) == 1 && d.Filter == D3D12_FILTER_ANISOTROPIC && d.MaxAnisotropy == 8,
          "trilinear anisotropic");
    set_regs(&r, 0x00050101u, 0x02060000u, 0x80000000u, 0);
    check(rsx_guest_sampler(&r, &d) == 0, "legacy clamp falls back");
    set_regs(&r, 0x00010101u, 0x02060000u, 0, 0);
    check(rsx_guest_sampler(&r, &d) == 0, "disabled unit falls back");
    check(rsx_guest_sampler_mask("SamplerState rsx_samp[16];\nrsx_tex[0].Sample(rsx_samp[0], uv)") == 1u,
          "mask: declaration is not a unit");
    check(rsx_guest_sampler_mask("rsx_tex10.Sample(rsx_samp[10], uv) rsx_tex[3].Sample(rsx_samp[3], uv)")
          == ((1u << 10) | (1u << 3)), "mask: unit 10 is not unit 1");
    check(rsx_guest_sampler_mask("SamplerState rsx_samp1 : register(s1);\nSamplerComparisonState rsx_cmp3 : register(s3);\n"
                                 "SamplerState rsx_samp12 : register(s12);\n"
                                 "rsx_tex3.SampleCmpLevelZero(rsx_cmp3,uv,z) rsx_tex12.Sample(rsx_samp12, uv)")
          == ((1u << 3) | (1u << 12)), "mask: individual names, declarations excluded");
}

/* ---- native D24 views ---------------------------------------------------- */
static void depth_checks(void)
{
    rsx_depth_sample_view v;
    const u32 on = 0x80000000u | (3072u << 7), clamp = 0x00030303u;
    check(rsx_depth_sample_view_init(&v, 0x90, 1024, 1024, 1, 0, 0, (1u << 28) | clamp, 0x02020000u, on, 2048, 2048) == 1 &&
          v.compare && v.func == 1 && v.linear, "D24 LESS compare view");
    check(rsx_depth_sample_view_init(&v, 0x90 | 0x20, 512, 512, 1, 0, 0, (3u << 28) | clamp, 0x01010000u, on, 2048, 2048) == 1 &&
          v.compare && !v.linear, "LN/UN layout bits ignored, point compare");
    check(rsx_depth_sample_view_init(&v, 0x90, 1024, 1024, 1, 0, 0, (7u << 28) | clamp, 0x02020000u, on, 2048, 2048) == 1 &&
          !v.compare, "ALWAYS reads the depth value");
    check(rsx_depth_sample_view_init(&v, 0x90, 1024, 1024, 1, 0, 0, (1u << 28) | clamp, 0x02020000u, on | 4u, 2048, 2048) == 1 &&
          !v.compare, "alpha kill disables comparison");
    check(rsx_depth_sample_view_init(&v, 0x90, 1024, 1024, 1, 0, 0, (1u << 28) | 0x00010101u, 0x02020000u, on, 2048, 2048) == -1,
          "cropped wrap is rejected");
    check(rsx_depth_sample_view_init(&v, 0x90, 2048, 2048, 1, 0, 0, (1u << 28) | 0x00010101u, 0x02020000u, on, 2048, 2048) == 1,
          "full-size wrap is exact");
    check(rsx_depth_sample_view_init(&v, 0x92, 1024, 1024, 1, 0, 0, (1u << 28) | clamp, 0x02020000u, on, 2048, 2048) == 0,
          "D16 stays on the existing path");
    check(rsx_depth_sample_view_init(&v, 0x90, 1024, 1024, 4, 0, 0, (1u << 28) | clamp, 0x02020000u, on, 2048, 2048) == -1,
          "mipmapped depth is rejected");
    check(rsx_depth_sample_view_init(&v, 0x90, 1024, 1024, 1, 0, 0, (1u << 28) | clamp, 0x02020000u, 0, 2048, 2048) == 0,
          "disabled unit is not a view");
    /* RSX stored FUNC reference vs D3D reference FUNC stored. */
    const u32 want[8] = {D3D12_COMPARISON_FUNC_NEVER, D3D12_COMPARISON_FUNC_GREATER, D3D12_COMPARISON_FUNC_EQUAL,
        D3D12_COMPARISON_FUNC_GREATER_EQUAL, D3D12_COMPARISON_FUNC_LESS, D3D12_COMPARISON_FUNC_NOT_EQUAL,
        D3D12_COMPARISON_FUNC_LESS_EQUAL, D3D12_COMPARISON_FUNC_ALWAYS};
    int order = 1;
    for (u32 f = 0; f < 8; ++f) order &= rsx_depth_sample_d3d_func(f) == want[f];
    check(order, "comparison order reversed for ordered functions only");
    char hlsl[2048];
    rsx_depth_sample_view_init(&v, 0x90, 1024, 512, 1, 0, 0, (4u << 28) | clamp, 0x02020000u, on, 2048, 2048);
    check(rsx_depth_sample_hlsl(hlsl, sizeof hlsl, 3, &v) > 0 &&
          strstr(hlsl, "rsx_tex3.SampleCmpLevelZero(rsx_cmp3,uv,saturate(p.z))") &&
          strstr(hlsl, "uv.x=clamp(uv.x,0.5/1024.0,1.0-0.5/1024.0)*(1024.0/2048.0)") &&
          strstr(hlsl, "uv.y=clamp(uv.y,0.5/512.0,1.0-0.5/512.0)*(512.0/2048.0)"), "compare helper crops in guest texels");
    rsx_depth_sample_view_init(&v, 0x90 | 0x40, 2048, 2048, 1, 0, 0, clamp, 0x01010000u, on, 2048, 2048);
    check(rsx_depth_sample_hlsl(hlsl, sizeof hlsl, 5, &v) > 0 && strstr(hlsl, "p.xy / float2(2048.0,2048.0)") &&
          strstr(hlsl, "rsx_tex5.SampleLevel(rsx_samp5,uv,0.0).r"), "unnormalized depth read");
    /* Sampler table entry for a compare unit, and only on sampled units. */
    D3D12DrawRecord dr; draw_init(&dr, 0);
    rsx_depth_sample_view_init(&dr.depth_view[3], 0x90, 1024, 1024, 1, 0, 0, (1u << 28) | clamp, 0x02020000u, on, 2048, 2048);
    dr.sampler[3].address = (1u << 28) | clamp;
    D3D12_SAMPLER_DESC t[16]; int set[16];
    for (unsigned u = 0; u < 16; ++u) set[u] = 1;
    rsx_guest_sampler_table(dr.sampler, set, 1u << 3, dr.depth_view, t);
    check(t[3].Filter == D3D12_ENCODE_BASIC_FILTER(1, 1, 0, D3D12_FILTER_REDUCTION_TYPE_COMPARISON) &&
          t[3].ComparisonFunc == D3D12_COMPARISON_FUNC_GREATER && t[3].AddressU == D3D12_TEXTURE_ADDRESS_MODE_CLAMP &&
          t[3].MaxLOD == 0.0f, "comparison sampler for a native compare unit");
    rsx_guest_sampler_table(dr.sampler, set, 0, dr.depth_view, t);
    check(t[3].Filter == D3D12_FILTER_MIN_MAG_MIP_LINEAR, "unsampled native unit keeps the legacy sampler");
}

/* ---- active sampler mask: P2 #3 ----------------------------------------- */
static void mask_checks(void)
{
    /* Only unused enabled unit 15 changes across 130 draws of a PS sampling u0. */
    unsigned before = s_sampler_tables_made, heaps_before = heap_n;
    D3D12DrawRecord dr;
    for (unsigned i = 0; i < 130; ++i) {
        draw_init(&dr, 0);
        dr.sampler[15].border = 0x01000000u * (i + 1);
        dr.sampler[15].address = 0x00040404u;
        guest_sampler_bind(&dr, 1u);
    }
    check(s_sampler_tables_made - before == 1 && heap_n - heaps_before <= 1,
          "unused unit changes create no sampler identities");
    /* A real change on the sampled unit still creates a table. */
    draw_init(&dr, 0); dr.sampler[0].address = 0x00020202u;
    guest_sampler_bind(&dr, 1u);
    check(s_sampler_tables_made - before == 2 && last_written[0].AddressU == D3D12_TEXTURE_ADDRESS_MODE_MIRROR,
          "sampled unit change is kept");
    /* Fallback pipelines (mask 0) bind the legacy table on every unit. */
    draw_init(&dr, 0);
    guest_sampler_bind(&dr, 0u);
    check(last_written[0].Filter == D3D12_FILTER_MIN_MAG_MIP_POINT &&
          last_written[0].AddressU == D3D12_TEXTURE_ADDRESS_MODE_CLAMP, "fallback keeps legacy unit 0");

    /* Merging: the recorded program samples u0 only. */
    s_fp_snap[4].hash = 0xABCDEF01ull;
    guest_sampler_note_mask(0xABCDEF01ull, 1u);
    draw_init(&dr, 0); dr.fp_snap = 5;
    for (unsigned u = 0; u < 16; ++u) {
        state.textures[u].address = dr.sampler[u].address; state.textures[u].filter = dr.sampler[u].filter;
        state.textures[u].control0 = dr.sampler[u].control0; state.textures[u].border_color = dr.sampler[u].border;
    }
    s_d3d.current_rsx_state = &state;
    check(guest_sampler_matches(&dr), "identical state merges");
    state.textures[15].address = 0x00040404u;
    check(guest_sampler_matches(&dr), "unsampled unit change does not split a merge");
    state.textures[15].address = dr.sampler[15].address;
    state.textures[0].filter = 0x01010000u;
    check(!guest_sampler_matches(&dr), "sampled unit change splits a merge");
    state.textures[0].filter = dr.sampler[0].filter;
    guest_sampler_note_mask(0xABCDEF01ull, 1u << 7);
    dr.sampler[7].control0 = 0; state.textures[7].control0 = 0; state.textures[7].address = 0x00030303u;
    check(guest_sampler_matches(&dr), "unit disabled on both sides does not split a merge");
    state.textures[7].control0 = 0x80000000u;
    check(!guest_sampler_matches(&dr), "enabling a sampled unit splits a merge");
    state.textures[7].control0 = 0; state.textures[7].address = dr.sampler[7].address;
    dr.fp_snap = 6;   /* hash 0: never compiled -> every unit compared */
    state.textures[15].address = 0x00040404u;
    check(!guest_sampler_matches(&dr), "unknown program compares every unit");
    state.textures[15].address = dr.sampler[15].address;
}

/* ---- checked retirement: P1 --------------------------------------------- */
static unsigned fill_overflow(void)
{
    D3D12DrawRecord dr;
    unsigned first = heap_n;
    for (unsigned i = 0; i < GUEST_SAMPLER_TABLES + 3; ++i) {
        draw_init(&dr, 0); dr.sampler[0].border = 0x01000000u * (i + 1); dr.sampler[0].address = 0x00040404u;
        guest_sampler_bind(&dr, 1u);
    }
    return heap_n - first;
}
static void retire_checks(const char* mode)
{
    frame_complete();
    check(guest_sampler_retire() == 1, "clean retirement");
    unsigned made = fill_overflow();
    check(s_sampler_overflow != NULL && made >= 1, "frame overflows into a second heap");
    GuestSamplerHeap* overflow = s_sampler_overflow;
    ID3D12DescriptorHeap* oheap = overflow->heap;
    unsigned base_count = s_sampler_base->count;
    if (mode) {
        u32 fi = s_d3d.frame_index;
        s_d3d.fence_values[fi]++;                      /* this frame's work is queued */
        if (!strcmp(mode, "device")) { devices[0].status = -1; fence.value = s_d3d.fence_values[fi]; }
        else if (!strcmp(mode, "incomplete")) fence.value = s_d3d.fence_values[fi] - 1;
        else if (!strcmp(mode, "removed-sentinel")) fence.value = UINT64_MAX;
        else { printf("unknown mode\n"); exit(2); }
        check(guest_sampler_retire() == 0, "failed retirement reports failure");
        check(s_sampler_overflow == overflow && oheap->refs == 1, "failed retirement keeps overflow heaps");
        check(s_sampler_base->count == base_count, "failed retirement keeps base descriptors");
        devices[0].status = S_OK;
    }
    frame_complete();
    check(guest_sampler_retire() == 1, "completed retirement");
    check(s_sampler_overflow == NULL && oheap->refs == 0, "completed retirement releases overflow");
    check(s_sampler_base->count == 0, "base heap recycles from slot 0 after retirement");
}

/* ---- shutdown and re-initialization: P2 #2 ------------------------------ */
static void shutdown_checks(int fail)
{
    fill_overflow();
    ID3D12DescriptorHeap* base = s_sampler_base->heap;
    ID3D12DescriptorHeap* overflow = s_sampler_overflow->heap;
    if (fail) { s_d3d.fence_values[s_d3d.frame_index]++; fence.value = UINT64_MAX; }
    else frame_complete();
    guest_sampler_shutdown();
    check(!s_sampler_base && !s_sampler_overflow && !s_sampler_bound, "shutdown clears every owner");
    if (fail) check(base->refs == 1 && overflow->refs == 1, "failed shutdown retirement never releases heaps");
    else check(base->refs == 0 && overflow->refs == 0, "shutdown releases every heap");
    /* New device: the next bind must create a heap there, not reuse the old one. */
    s_d3d.device = &devices[1]; fence.value = 0; s_d3d.fence_values[0] = s_d3d.fence_values[1] = 0;
    D3D12DrawRecord dr; draw_init(&dr, 0);
    guest_sampler_bind(&dr, 1u);
    check(s_sampler_base && s_sampler_base->heap->owner == &devices[1] && set_heaps[1]->owner == &devices[1],
          "re-initialized renderer binds a heap of the new device");
}

int main(int argc, char** argv)
{
    setvbuf(stdout, NULL, _IONBF, 0);   /* keep FAIL lines if a mutant crashes */
    devices[0].lpVtbl = devices[1].lpVtbl = &dev_vtbl;
    list.lpVtbl = &list_vtbl; fence.lpVtbl = &fence_vtbl;
    s_d3d.device = &devices[0]; s_d3d.cmd_list = &list; s_d3d.fence = &fence;
    s_d3d.frame_index = 1; s_d3d.fence_values[1] = 41;
    const char* mode = argc > 1 ? argv[1] : NULL;
    decoder_checks();
    depth_checks();
    mask_checks();
    if (mode && !strcmp(mode, "shutdown-failed")) shutdown_checks(1);
    else {
        retire_checks(mode);
        shutdown_checks(0);
    }
    printf("checks=%u failures=%u\n", checks, failures);
    return failures ? 1 : 0;
}
