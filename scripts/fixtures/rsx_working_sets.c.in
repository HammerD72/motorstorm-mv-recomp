/* Execute the production shutdown owner with authored COM resources. */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <signal.h>
#include "rsx_pipeline_cache.h"
typedef struct Resource Resource;
typedef struct { void (*Release)(Resource*); } ResourceVtbl;
struct Resource { ResourceVtbl* lpVtbl; unsigned refs; };
typedef struct { Resource* res; Resource* up; } VPTexSlot;
typedef struct { Resource* pso; } VPFPEntry;
static struct {
    int initialized, vp_vs_n;
    struct { void* disk_source; } vp_vs[1];
    unsigned vp_tex_capacity;
    VPTexSlot* vp_tex;
    VPFPEntry* vp_fp;
    rsx_pipeline_cache vp_fp_store;
} s_d3d;
int s_fp_bytecode, s_fp_blob_ops;
static unsigned releases, failures, retire_calls;
static int failure_mode;
void cpu_surface_shutdown(void) {}
void shader_forget_vs_source(void* source) { (void)source; }
void shader_pool_finish(void) {}
void rsx_shader_cache_clear(int* cache, int* ops) { (void)cache; (void)ops; }
@RETIRE@
@FUNCTION@
static void release(Resource* object) {
    ++releases;
    if (!object->refs) { ++failures; fprintf(stderr, "FAIL double release\n"); }
    --object->refs;
}
static void aborted(int number) {
    (void)number;
    if (failure_mode && retire_calls == 1 && !releases && s_d3d.vp_fp_store.count == 2 && s_d3d.vp_tex_capacity == 2) {
        fprintf(stderr, "retirement failed; all GPU owners preserved\n"); _Exit(77);
    }
    fprintf(stderr, "FAIL GPU owners released before failed retirement\n"); _Exit(78);
}
int main(int argc, char** argv) {
    (void)argv;
    signal(SIGABRT, aborted);
    failure_mode = argc > 1;
    ResourceVtbl vtable = {release}; Resource owners[6];
    for (unsigned i = 0; i < 6; ++i) { owners[i].lpVtbl = &vtable; owners[i].refs = 1; }
    s_d3d.initialized = 1;
    s_d3d.vp_fp_store.count = s_d3d.vp_fp_store.capacity = 2;
    s_d3d.vp_fp = s_d3d.vp_fp_store.data = calloc(2, sizeof(VPFPEntry));
    s_d3d.vp_tex_capacity = 2; s_d3d.vp_tex = calloc(2, sizeof(VPTexSlot));
    if (!s_d3d.vp_fp || !s_d3d.vp_tex) return 2;
    for (unsigned i = 0; i < 2; ++i) {
        s_d3d.vp_fp[i].pso = owners + i;
        s_d3d.vp_tex[i].res = owners + 2 + i * 2;
        s_d3d.vp_tex[i].up = owners + 3 + i * 2;
    }
    gpu_working_sets_release();
    if (failure_mode) { fprintf(stderr, "FAIL failed retirement continued teardown\n"); return 1; }
    if (retire_calls != 1 || releases != 6 || s_d3d.vp_fp || s_d3d.vp_tex || s_d3d.vp_fp_store.count || s_d3d.vp_tex_capacity) ++failures;
    for (unsigned i = 0; i < 6; ++i) if (owners[i].refs) ++failures;
    printf("releases=%u failures=%u\n", releases, failures); return failures ? 1 : 0;
}
